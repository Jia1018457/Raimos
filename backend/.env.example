# ── 必填 ─────────────────────────────────────────────────────────────────────
# Firebase 服务账号完整 JSON（从 { 开始到 } 结束，全部在一行内）
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"YOUR_PROJECT","private_key":"...","client_email":"..."}

# 你的 Firebase 用户 UID（Firebase Console → Authentication → Users 里复制）
RAIMOS_UID=your_firebase_user_uid_here

# ── 可选 ─────────────────────────────────────────────────────────────────────
# 后备 AI API Key（优先用前端设置里填的，这里填了则服务端也能独立调用）
OPENROUTER_API_KEY=sk-or-v1-...

# HTTP 端口（Railway 会自动注入 PORT，本地调试可改）
PORT=3000

# Web Push VAPID 密钥（留空，第一次启动后从后台日志复制生成的密钥填进来再重启）
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
