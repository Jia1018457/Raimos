# ── Firebase ──────────────────────────────────────────────────────────
# Paste the entire Firebase service account JSON as a single-line string
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# UID of the Raimos user this backend serves (find in Firebase Console → Authentication)
RAIMOS_UID=your_firebase_user_uid_here

# ── OpenRouter (fallback if user's key not in Firestore) ───────────────
OPENROUTER_API_KEY=sk-or-v1-...

# ── Railway / HTTP ─────────────────────────────────────────────────────
PORT=3000
